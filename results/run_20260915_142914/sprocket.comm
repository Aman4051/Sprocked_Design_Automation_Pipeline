res_bol = MECA_STATIQUE(MODELE=model, CHAM_MATER=fieldmat, EXCIT=(_F(CHARGE=bc_fixed), _F(CHARGE=bc_bol)), SOLVEUR=_F(METHODE='GCPC', PRE_COND='LDLT_SP'))
